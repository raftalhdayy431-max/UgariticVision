<?xml version="1.0" encoding="utf-8"?><FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
<com.ugaritic.vision.AnnotationView android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="12dp" android:background="#99000000">
<TextView android:id="@+id/result_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="جارٍ التحميل..." android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:padding="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/freeze_btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="تجميد"/><Button android:id="@+id/gallery_btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="المعرض"/><Button android:id="@+id/copy_btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="نسخ"/></LinearLayout>
</LinearLayout></FrameLayout>
