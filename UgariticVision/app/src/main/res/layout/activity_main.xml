<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- الشريط العلوي (Header) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#141A24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UGARITIC VISION AI"
            android:textColor="#EBEFF2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#141A24"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="LIVE CAMERA"
            android:textColor="#00B4D8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- منطقة عرض الصورة والكاميرا (Hero Viewport) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/imageCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#05080D"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/chipsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- الكاميرا أو الصورة المعالجة -->
        <ImageView
            android:id="@+id/mainImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
            
    </androidx.cardview.widget.CardView>

    <!-- الفلاتر (Chips) -->
    <LinearLayout
        android:id="@+id/chipsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <CheckBox
            android:id="@+id/chipBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boxes"
            android:textColor="#00B4D8"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chipConf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confidence"
            android:textColor="#00B4D8"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chipChars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Labels"
            android:textColor="#808C99"
            android:checked="false" />
    </LinearLayout>

    <!-- شريط الأزرار السفلي (Action Bar) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#141A24"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#FF9919"
            android:text="ANALYZE"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLiveCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#00B4D8"
            android:text="LIVE CAMERA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#263347"
            android:text="GALLERY"
            android:textColor="#E6E6E6"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
